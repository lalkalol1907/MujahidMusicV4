DISCORD_TOKEN=your-bot-token-here

LAVALINK_HOST=localhost
LAVALINK_PORT=2333
LAVALINK_PASSWORD=youshallnotpass

DEV_GUILD_ID=

MONGO_USER=mujahid
MONGO_PASSWORD=change-me-please
MONGO_DB=mujahid
# ONEOF
MONGO_URI=mongodb://mujahid:change-me-please@localhost:27017/?authSource=admin

HEALTH_FILE=/tmp/mujahid-health
LOG_LEVEL=INFO

# Metrics HTTP server port (Prometheus /metrics + /health)
METRICS_PORT=9090

# Bot Control Plane (internal service-to-service)
INTERNAL_PORT=9091
# Generate: openssl rand -hex 32 (must differ from ADMIN_API_KEY)
INTERNAL_API_KEY=

# Admin API (Bun + Hono BFF)
ADMIN_API_PORT=8080
# Generate: openssl rand -hex 32 (must differ from INTERNAL_API_KEY)
ADMIN_API_KEY=
ADMIN_CORS_ORIGIN=http://localhost:5173
BOT_INTERNAL_URL=http://localhost:9091
BOT_METRICS_URL=http://localhost:9090
ENVIRONMENT=development

# Docker Hub images (prod deploy / CI tag v*)
IMAGE_NAME=your-dockerhub-username/mujahidmusicv4
ADMIN_API_IMAGE_NAME=your-dockerhub-username/mujahidmusicv4-admin-api
ADMIN_WEB_IMAGE_NAME=your-dockerhub-username/mujahidmusicv4-admin-web
IMAGE_TAG=latest
